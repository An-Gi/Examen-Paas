# Cliente OpenVPN: {{ cliente.nombre }} — generado por Ansible (rol openvpn). Contiene la llave privada:
# no subir a Git ni compartir por chat. Uso: sudo openvpn --config {{ cliente.nombre }}.ovpn
client
dev {{ vpn_dev }}
proto {{ vpn_proto }}
remote {{ ansible_host }} {{ vpn_puerto }}
resolv-retry infinite
nobind
persist-key
persist-tun
# Verifica que el otro extremo tenga un certificado de servidor (evita que otro cliente se haga pasar por él)
remote-cert-tls server
verb 3
{% if cliente.sin_redirect_gateway | default(false) %}
# Este cliente solo usa el túnel para recibir el tráfico del reverse proxy:
# su salida a Internet y su DNS siguen siendo los de la LAN
pull-filter ignore "redirect-gateway"
pull-filter ignore "dhcp-option"
{% endif %}
<ca>
{{ ca_crt }}
</ca>
<cert>
{{ cliente_crt }}
</cert>
<key>
{{ cliente_key }}
</key>
<tls-crypt>
{{ tls_crypt_key }}
</tls-crypt>
