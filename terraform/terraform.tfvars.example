# Copiar a terraform.tfvars (ignorado por Git) y completar.
region             = "us-east-1"
perfil_aws         = "examen-paas"
tipo_instancia     = "t3.micro"
ruta_llave_publica = "~/.ssh/examen-paas.pub"

# Tu IP pública: curl -s https://checkip.amazonaws.com
# Si cambia (otra red, la universidad), actualizar y hacer terraform apply.
cidr_admin = "0.0.0.0/32"
