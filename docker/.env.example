# Copiar a docker/.env (ignorado por Git). Valores reales: gestor de contraseñas del equipo.
# Lo usan todos los compose a través de ./compose.sh (--env-file .env).

# --- Comunes ---
DOMINIO_LAN=paas.internal
IP_DOCKER01=10.10.10.30
LAN_IFACE=enp0s9          # NIC de la LAN en las VMs ARM64 (ADR-0002)
TZ=America/Costa_Rica

# --- 02-ldap (A) ---
LDAP_ADMIN_PASSWORD=cambiar
# AD en EC2 (terraform/ad.tf): IP de "terraform output ad_ip_privada", alcanzable por la VPN de docker01.
AD_URL=ldap://172.31.0.50
AD_DOMINIO=ad.paas.internal
# Debe ser IGUAL a ad_password_sync de terraform.tfvars (copiarla del gestor; generar-env.sh no la inventa)
AD_SYNC_PASSWORD=copiar-del-gestor
AD_SYNC_INTERVALO=120

# --- 04-owncloud (B) ---
OWNCLOUD_ADMIN_USER=admin
OWNCLOUD_ADMIN_PASSWORD=cambiar
OWNCLOUD_DB_PASSWORD=cambiar
OWNCLOUD_DB_ROOT_PASSWORD=cambiar

# --- 05-ftp (B) ---
FTP_USER=ftpuser
FTP_PASSWORD=cambiar

# --- 06-smb (B) ---
SMB_USER=smbuser
SMB_PASSWORD=cambiar

# --- extras ---
GRAFANA_ADMIN_PASSWORD=cambiar
