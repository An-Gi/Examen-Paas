# Copiar a docker/.env (ignorado por Git). Valores reales: gestor de contraseñas del equipo.
# Lo usan todos los compose a través de ./compose.sh (--env-file .env).

# --- Comunes ---
DOMINIO_LAN=paas.internal
IP_DOCKER01=10.10.10.30
TZ=America/Costa_Rica

# --- 02-ldap (A) ---
LDAP_ADMIN_PASSWORD=cambiar

# --- 04-owncloud (B) ---
OWNCLOUD_ADMIN_USER=admin
OWNCLOUD_ADMIN_PASSWORD=cambiar
OWNCLOUD_DB_PASSWORD=cambiar
OWNCLOUD_DB_ROOT_PASSWORD=cambiar

# --- 05-ftp (B) ---
FTP_USER=ftpuser
FTP_PASSWORD=cambiar

# --- 06-smb (B) ---
SMB_USER=smbuser
SMB_PASSWORD=cambiar

# --- extras ---
GRAFANA_ADMIN_PASSWORD=cambiar
